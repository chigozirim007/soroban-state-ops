FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

# Copy lockfile and all workspace package manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/lint-npm/package.json packages/lint-npm/
COPY packages/signer-sdk/package.json packages/signer-sdk/
COPY packages/keeper/package.json packages/keeper/
COPY packages/api/package.json packages/api/
COPY packages/dashboard/package.json packages/dashboard/
RUN pnpm install --frozen-lockfile

# Build shared types first
COPY packages/shared-types/ packages/shared-types/
RUN pnpm --filter @soroban-ops/shared-types build

# Build dashboard with standalone output
COPY packages/dashboard/ packages/dashboard/
ENV OUTPUT_STANDALONE=true
RUN pnpm --filter @soroban-ops/dashboard build

# Production stage
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy standalone build output
COPY --from=base /app/packages/dashboard/.next/standalone ./
COPY --from=base /app/packages/dashboard/.next/static ./packages/dashboard/.next/static
COPY --from=base /app/packages/dashboard/public ./packages/dashboard/public

EXPOSE 3000

USER node
WORKDIR /app/packages/dashboard
CMD ["node", "server.js"]
