FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

# Copy all workspace package manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/lint-npm/package.json packages/lint-npm/
COPY packages/signer-sdk/package.json packages/signer-sdk/
COPY packages/keeper/package.json packages/keeper/
COPY packages/api/package.json packages/api/
COPY packages/dashboard/package.json packages/dashboard/

# Install all monorepo dependencies with intact symlinks
RUN pnpm install --frozen-lockfile

# Build shared dependencies
COPY packages/shared-types/ packages/shared-types/
RUN pnpm --filter @soroban-ops/shared-types build

COPY packages/signer-sdk/ packages/signer-sdk/
RUN pnpm --filter @soroban-ops/signer-sdk build

# Build keeper service
COPY packages/keeper/ packages/keeper/
RUN pnpm --filter @soroban-ops/keeper build

EXPOSE 8080
USER node
CMD ["node", "packages/keeper/dist/index.js"]
